    * assumed. See the module-level subgroup note.
    */
-  pure circuit ecNeg(p: JubjubPoint): JubjubPoint {
-    return ecMul(p, JUBJUB_SUBGROUP_ORDER_MINUS_ONE());
+  pure circuit ecNegViaOrder(p: JubjubPoint): JubjubPoint {
