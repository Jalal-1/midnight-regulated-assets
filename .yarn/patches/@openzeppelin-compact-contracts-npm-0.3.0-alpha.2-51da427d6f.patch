   }
 
   // ---------------------------------------------------------------------------
@@ -186,7 +186,7 @@ module ElGamal {
    * before treating it as private.
    */
   export pure circuit encryptZero(): Ciphertext {
-    const id = ecMulGenerator(0 as Field);
+    const id = ecMulGenerator(0 as Field as JubjubScalar);
