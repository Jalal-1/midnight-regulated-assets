-    const mask = ecMul(pk, r);
+    const c1 = ecMulGenerator(r as JubjubScalar);
+    const mask = ecMul(pk, r as JubjubScalar);
     const c2 = ecAdd(mask, m);
     return Ciphertext { c1: c1, c2: c2 };
   }
@@ -240,7 +240,7 @@ module ElGamal {
    * @return The ciphertext `(g^r, pk^r * g^value)`.
