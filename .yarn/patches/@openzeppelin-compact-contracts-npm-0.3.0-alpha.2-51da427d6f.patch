+    const ekC1 = ecMul(ct.c1, ekField as JubjubScalar);
+    const mPoint = ecAdd(ct.c2, ecNegViaOrder(ekC1));
     assert(mPoint == m,
            "ElGamal: plaintext mismatch");
   }
@@ -468,6 +468,6 @@ module ElGamal {
                    ek: Bytes<32>,
                    claimedValue: Uint<128>
                    ): [] {
-    assertDecryptsToPoint(ct, pk, ek, ecMulGenerator(claimedValue as Field));
+    assertDecryptsToPoint(ct, pk, ek, ecMulGenerator(claimedValue as Field as JubjubScalar));
