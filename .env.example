# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# --- Network -----------------------------------------------------------------
# localnet (default) | stagenet
# MRA_NETWORK=localnet
# Override the NetworkId string if Stagenet disagrees with 'stagenet'.
# MRA_NETWORK_ID=stagenet

# --- Proof server ------------------------------------------------------------
# Unset  => prove LOCALLY at http://localhost:6300. Witness data never leaves
#           this machine. This is the default and the private option.
#
# Set    => prove on a THIRD-PARTY hosted prover (e.g. a confidential space).
#           Witness data leaves this machine, so only do this where the
#           provider's TEE attestation is part of your trust model.
#
# Must be https (localhost exempt), and the API key is then mandatory.
# MRA_PROOF_SERVER_URL=https://prover.example.com
# MRA_PROOF_SERVER_API_KEY=

# Header name and value prefix. Defaults shown; set the scheme empty for a bare key.
# MRA_PROOF_SERVER_AUTH_HEADER=Authorization
# MRA_PROOF_SERVER_AUTH_SCHEME=Bearer

# Request timeout. Defaults: 300000 local, 600000 hosted.
# MRA_PROOF_SERVER_TIMEOUT_MS=600000

# --- Private state -----------------------------------------------------------
# Encrypts private state at rest. 16+ chars, 3 of upper/lower/digit/special,
# no more than 3 identical in a row. Encryption is not optional in midnight-js 5.x.
# MRA_PRIVATE_STATE_PASSWORD=
