# Stagenet "Ledger RC3 compatible" stack, run locally.
# Keep in sync with ops/versions.lock.json — that file is the explanation,
# this one is what docker actually reads. All three tags verified present on
# Docker Hub (midnightntwrk/*) on 2026-08-13.
MIDNIGHT_NODE_VERSION=2.0.0-rc.4
PROOF_SERVER_VERSION=9.0.0-rc.6

# NOTE: the release is "4.4.0-rc.1", but there is no plain tag by that
# name — the published image carries the full build suffix below. Shortening it
# gives "manifest unknown" on pull.
INDEXER_VERSION=4.4.0-rc.1
