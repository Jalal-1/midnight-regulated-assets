// Toolchain proof. This contract exists to answer one question:
// does the pinned stack compile, deploy, prove, and submit end to end?
//
// Kept byte-for-byte identical to the upstream canonical example
// (LFDT-Minokawa/compact: examples/counter.compact) so that any failure is a
// toolchain problem, never a contract problem. Do not "improve" it.
//
// Note: no `pragma language_version` — the upstream example does not declare one.

import CompactStandardLibrary;

export ledger round: Counter;

export circuit increment(): [] {
  round.increment(1);
}
