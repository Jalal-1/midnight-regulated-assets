{
  "name": "midnight-regulated-assets",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc -b",
    "check:clean": "tsc -b --clean && tsc -b",
    "localnet:up": "docker compose -f ops/localnet/compose.yml down -v --remove-orphans 2>/dev/null; docker compose --env-file ops/localnet/env/rc3.env -f ops/localnet/compose.yml up -d --wait --force-recreate",
    "localnet:resume": "docker compose --env-file ops/localnet/env/rc3.env -f ops/localnet/compose.yml up -d --wait",
    "localnet:down": "docker compose -f ops/localnet/compose.yml down -v",
    "toolchain": "./ops/setup-toolchain.sh",
    "redeploy": "./ops/redeploy.sh",
    "ui": "yarn workspace @mra/portal dev",
    "logs": "node ops/log-sidecar/server.mjs",
    "counter:deploy": "yarn workspace @mra/app-counter deploy"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.0.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "resolutions": {
    "@midnight-ntwrk/platform-js": "3.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3",
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "bn.js": "5.2.5"
  }
}
